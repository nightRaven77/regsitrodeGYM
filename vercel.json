{
  "version": 2,
  "builds": [
    { "src": "app_server.py", "use": "@vercel/python" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "app_server.py" },
    { "src": "/sw.js", "dest": "app_server.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
