# ============================================================
# GYM TRACKER - VARIABLES DE ENTORNO
# ============================================================

# 1. Base de datos principal (Supabase PostgreSQL / Railway / Render)
# Obtenla en Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_REF].supabase.co:5432/postgres

# 2. API REST de Supabase (Opcional, para ping vía PostgREST)
# Obtenlas en Supabase: Project Settings -> API
SUPABASE_URL=https://[TU_REF].supabase.co
SUPABASE_KEY=eyJhbGciOi...

# 3. URL de la aplicación desplegada (Opcional, para despertar tu servidor en Render/Railway)
# Ejemplo: https://mygymtracker.onrender.com
APP_URL=

# 4. Puerto local del servidor (Opcional, por defecto 8000)
PORT=8000
